{
  "private": true,
  "name": "electron-app",
  "version": "0.0.0",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.72.1",
    "@theia/editor": "1.72.1",
    "@theia/electron": "1.72.1",
    "@theia/filesystem": "1.72.1",
    "@theia/markers": "1.72.1",
    "@theia/messages": "1.72.1",
    "@theia/monaco": "1.72.1",
    "@theia/navigator": "1.72.1",
    "@theia/plugin-ext-vscode": "1.72.1",
    "@theia/preferences": "1.72.1",
    "@theia/process": "1.72.1",
    "@theia/terminal": "1.72.1",
    "@theia/workspace": "1.72.1",
    "nautical-theme": "0.0.0",
    "node-pty": "*",
    "native-keymap": "*",
    "find-git-repositories": "*",
    "drivelist": "*",
    "keytar": "*",
    "ssh2": "*",
    "cpu-features": "*"
  },
  "devDependencies": {
    "@theia/cli": "1.72.1",
    "electron": "39.8.7"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "kaboom": "cd ../nautical-theme && npm run build && cd ../electron-app && npm run bundle && npm run start",
    "quick": "theia build --mode development && npm run start",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start --plugins=local-dir:./plugins",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "electron": {
          "windowOptions": {
            "titleBarStyle": "hidden"
          }
        }
      }
    }
  },
  "overrides": {
    "yargs": "^17.7.2"
  },
  "theiaPlugins": {
    "nautical-theme": "local:../nautical-theme"
  },
  "theiaPluginsDir": "plugins"
}
